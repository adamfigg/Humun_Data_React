# Copy to .env.local and fill in. NEVER commit .env.local.
# Nothing here is needed to run the marketing site yet — these are for the
# signup flow that comes next (see TODO.md).

# Google OAuth (Sign in with Google → Analytics access)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Stripe (payment, built after signup works)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
